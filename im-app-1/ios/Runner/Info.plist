<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>私趣</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>私趣</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- Xinstall 免填邀请码（2026-11-14：Opo → Xinstall，官方 Flutter 插件）：
		     SDK 初始化用的 iOS appKey。键名固定 com.xinstall.APP_KEY，不能改。
		     ⚠️ 与 Opo（com.opoinstall.APP_KEY）/ 老版 openinstall
		        （com.openinstall.APP_KEY）键名都不同，三套 SDK 后端不互通；
		        键名写错 / appKey 填错的表现是「能装能开、注册页不填码」，且**不报错**。
		     Xinstall 全平台共用**同一个** appKey：
		     2026-11-14 客户提供 appKey=3zn6hb33（scheme=xi3zn6hb33），
		     与 android/gradle.properties 的 XINSTALL_APPKEY 同值。 -->
		<key>com.xinstall.APP_KEY</key>
		<string>3zn6hb33</string>
		<!-- 免填邀请码（2026-11-14）：一键拉起用的 URL Types。
		     2026-11-14 客户提供 Xinstall 后台 scheme = xi3zn6hb33（xi<appKey> 格式），
		     已替换 Opo 时代的 vincoi。iOS scheme 区分大小写，照抄后台值。
		     不要动 tobias 的 siquchat scheme —— pubspec.yaml 顶部的
		     tobias.url_scheme 依赖它，缺失会导致 pod install 失败。 -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.siqu.chat.xinstall</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>xi3zn6hb33</string>
				</array>
			</dict>
		</array>
		<!-- 出口合规声明：仅使用系统标准加密（HTTPS/TLS），无需 CCATS 文档。
		     若日后启用自研端到端加密算法，需改为 <true/> 并补充合规材料 -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- 音视频通话（腾讯云 TRTC）：iOS 缺这两项时一调用摄像头/麦克风就直接崩溃 -->
		<key>NSCameraUsageDescription</key>
		<string>视频通话需要使用摄像头拍摄画面</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>语音和视频通话需要使用麦克风采集声音</string>
		<!-- 相册选图发送（image_picker） -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>发送图片时需要访问相册</string>
		<!-- 朋友圈图片保存到相册（image_gallery_saver 只写入不读取） -->
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>保存图片到相册时需要添加照片权限</string>
		<!-- 极光 JCore 引用了 CoreLocation API（ITMS-90683）：App 本身不采集位置，
	     仅推送 SDK 在网络切换时用其做连接优化；拒绝授权不影响任何功能 -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>用于提升消息推送在网络切换时的送达可靠性，拒绝授权不影响使用</string>
		<!-- 发现页内置 WebView：仅对 App 内 WKWebView 放行 http 网页（小程序）；
	     App 自身网络请求仍强制 HTTPS；NSAllowsLocalNetworking 保留局域网 http 调试能力。
	     2026-09-19 补 NSAllowsArbitraryLoads：ad-hoc 分发包接口可能用 http（无证书域名），
	     iOS ATS 默认拦截一切 http → 启动页接口全挂反复重试像卡死。ad-hoc 包全局放行；
	     以后上 App Store 前再按需收紧（https 接口本来就不需要这行）。 -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
			<key>NSAllowsArbitraryLoadsInWebContent</key>
			<true/>
			<key>NSAllowsLocalNetworking</key>
			<true/>
		</dict>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- 极光推送必需：允许 App 退后台后仍接收 APNs 长连接唤醒 -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
